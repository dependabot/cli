#!/bin/sh
set -eu
[ "$DEPENDABOT_JOB_ID" = "42" ]
[ -z "$DEPENDABOT_JOB_TOKEN" ]
[ -z "${GITHUB_DEPENDABOT_JOB_TOKEN:-}" ]
[ -z "${GITHUB_DEPENDABOT_CRED_TOKEN:-}" ]
[ -z "${GITHUB_REGISTRIES_PROXY:-}" ]
[ "$DEPENDABOT_API_URL" = "$EXPECTED_UPDATER_API_URL" ]
! grep -Eq 'target|registry-secret|dependency-secret|env[$]TOKEN|env-custom-secret|env-duplicate-secret|env-proxy-secret|proxy-only.example|jit_access|accessible-repos' "$DEPENDABOT_JOB_PATH"
grep -Fq '"registry":"registry.example/npm/"' "$DEPENDABOT_JOB_PATH"
[ "$(grep -o '"registry":"registry.example/npm/"' "$DEPENDABOT_JOB_PATH" | wc -l)" -eq 1 ]
grep -Fq '"commit":"0123456789012345678901234567890123456789"' "$DEPENDABOT_JOB_PATH"
printf 'job=%s\n' "$DEPENDABOT_JOB_ID" > "$CACHE_PATH/result"
for attempt in $(seq 1 20); do
  if response=$(http_proxy= HTTP_PROXY= wget -qO- "$HTTP_PROXY"); then
    printf '%s\n' "$response"
    [ "$FAIL" = false ]
    exit
  fi
  sleep 0.1
done
echo "proxy did not become ready" >&2
exit 1
